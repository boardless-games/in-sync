  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Server - Prod",
      "request": "launch",
      "mainClass": "games.boardless.in_sync_server.InSyncApplication",
      "projectName": "in-sync-server",
      "env": {
        "insync.client.urls": "http://localhost:4200"
      }
    },
    {
      "type": "java",
      "name": "Server - Dev",
      "request": "launch",
      "mainClass": "games.boardless.in_sync_server.InSyncApplication",
      "projectName": "in-sync-server",
      "env": {
        "spring.profiles.active": "dev"
      }
    },
    {
      "type": "java",
      "name": "Server - Debug",
      "request": "launch",
      "mainClass": "games.boardless.in_sync_server.InSyncApplication",
      "projectName": "in-sync-server",
      "env": {
        "spring.profiles.active": "dev",
        "insync.premade.games": "123123,123456"
      }
    }
  ]
}
