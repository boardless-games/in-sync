  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Server - Prod",
      "request": "launch",
      "mainClass": "games.boardless.in_sync_server.InSyncApplication",
      "projectName": "in-sync-server",
      "env": {}
    },
    {
      "type": "java",
      "name": "Server - Dev",
      "request": "launch",
      "mainClass": "games.boardless.in_sync_server.InSyncApplication",
      "projectName": "in-sync-server",
      "env": {
        "spring.profiles.active": "dev"
      }
    },
    {
      "type": "java",
      "name": "Server - Debug",
      "request": "launch",
      "mainClass": "games.boardless.in_sync_server.InSyncApplication",
      "projectName": "in-sync-server",
      "env": {
        "spring.profiles.active": "dev",
        "insync.max.games": 10,
        "insync.player.wait.time": 30000,
        "insync.premade.games": "123123,123456"
      }
    }
  ]
}
